<!-- 
Indica si el siguiente documento XML está bien formado y en caso de no estarlo corrige los errores: 
<?xml version="1.0" encoding="UTF-8"?>
<texto>
    <Titulo>XML explicado a los niños</Titulo>
    <parrafo>El <abreviatura>XML</abreviatura> define como crear lenguajes de marcas.</parrafo>
    <parrafo>Las marcas se añaden a un documento de texto para añadir informacion.</parrafo>
    <http://>www.example.org</http://>
</texto>
-->
<!-- Solucion -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE texto[
<!ELEMENT texto (titulo, parrafo*)>
<!ELEMENT titulo (#PCDATA)>
<!ELEMENT abreviatura (enlace)>
<!ELEMENT enlace (#PCDATA)>
<!ELEMENT parrafo (#PCDATA)>
<!ATTLIST abreviatura identificador ID #REQUIRED>
<!ATTLIST enlace referencia IDREF #REQUIRED
]> 
<texto>
    <titulo>XML explicado a los niños</titulo>
    <parrafo>El <abreviatura>XML</abreviatura> define como crear lenguajes de marcas.</parrafo>
    <parrafo>Las marcas se añaden a un documento de texto para añadir informacion.</parrafo>
    <enlace>www.example.org</enlace>
</texto>