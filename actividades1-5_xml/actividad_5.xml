<?xml version="1.0" encoding="UTF-8"?>
<catalogo_flora>
  <especie nombre_cientifico="Acer monspessulanum">
    <nombre_comun>
      <nombre1>Arce de Montpellier</nombre1>
      <nombre2>Arce menor</nombre2>
    </nombre_comun>
    <vegetacion>Caducifolio</vegetacion>
    <altura>
      <valor>De 6 a 10</valor>
      <unidad>metros</unidad>
    </altura>
    <forma_estructura>
      <copa>Copa esférica</copa>
      <tronco>Tronco principal recto con bifurcaciones</tronco>
      <ramas>Ramaje colgante</ramas>
    </forma_estructura>
    <color_primavera>
      <haz>verde brillante</haz>
      <enves>verde blanquecino</enves>
    </color_primavera>
    <resistencia_heladas limite="-15">
      <valor>Heladas fuertes</valor>
    </resistencia_heladas>
  </especie>

  <especie nombre_cientifico="Olea europaea">
    <nombre_comun>
      <nombre1>Olivo</nombre1>
    </nombre_comun>
    <vegetacion>Perenne</vegetacion>
    <altura>
      <valor>De 8 a 15</valor>
      <unidad>metros</unidad>
    </altura>
    <forma_estructura>
      <copa>Copa irregular</copa>
      <tronco>Tronco principal irregular con bifurcaciones</tronco>
      <ramas>Ramaje tortuoso</ramas>
    </forma_estructura>
    <color_primavera>
      <haz>verde oscuro</haz>
      <enves>verde plateado</enves>
    </color_primavera>
    <resistencia_heladas limite="-10">
      <valor>Heladas medias</valor>
    </resistencia_heladas>
  </especie>

  <especie nombre_cientifico="Platanus orientalis">
    <nombre_comun>
      <nombre1>Plátano</nombre1>
    </nombre_comun>
    <vegetacion>Caducifolio</vegetacion>
    <altura>
      <valor>De 20 a 25</valor>
      <unidad>metros</unidad>
    </altura>
    <forma_estructura>
      <copa>Copa ovoidal</copa>
      <tronco>Tronco principal recto</tronco>
      <ramas>Ramaje expandido</ramas>
    </forma_estructura>
    <color_primavera>
      <haz>verde medio</haz>
      <enves>verde claro</enves>
    </color_primavera>
    <color_otono>Ocre</color_otono>
    <resistencia_heladas limite="-20">
      <valor>Heladas fuertes</valor>
    </resistencia_heladas>
  </especie>

  <especie nombre_cientifico="Quercus ilex">
    <nombre_comun>
      <nombre1>Encina</nombre1>
    </nombre_comun>
    <vegetacion>Perenne</vegetacion>
    <altura>
      <valor>En torno a 25</valor>
      <unidad>metros</unidad>
    </altura>
    <forma_estructura>
      <copa>Copa esférica o elíptica irregular</copa>
      <tronco>Tronco principal recto</tronco>
      <ramas>Ramaje tortuoso</ramas>
    </forma_estructura>
    <color_primavera>
      <haz>verde oscuro (hojas antiguas) o plateado (hojas jóvenes)</haz>
      <enves>plateado</enves>
    </color_primavera>
    <resistencia_heladas limite="-15">
      <valor>Heladas fuertes</valor>
    </resistencia_heladas>
  </especie>
</catalogo_flora>