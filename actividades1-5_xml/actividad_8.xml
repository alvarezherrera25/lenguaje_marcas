<!--Indica si el siguiente documento XML está bien formado y en caso de no estarlo corrige los errores: 
<?xml version="1.0" encoding="UTF-8"?>
<deportistas>
    <deportista>
        <deporte Atletismo />
        <nombre>Jesse Owens</nombre>
    </deportista>
        <deporte Natacion />
        <nombre>Mark Spitz</nombre>
    </deportista>
</deportistas>
-->
<!-- Solucion -->
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE deportistas [
<!ENTITY anio "1980">
<!ELEMENT deportistas (deportista+)>
<!ELEMENT deportista (deporte,nombre,nacimiento)>
<!ATTLIST deportista
  id ID #REQUIRED
  nacionalidad (Afroamericano | Estadounidense | Europeo) #REQUIRED>
<!ELEMENT deporte (#PCDATA)>
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT nacimiento (#PCDATA)>
]>

<deportistas>
    <deportista id="j1" nacionalidad="Afroamericano">
        <deporte>Atletismo</deporte>
        <nombre>Jesse Owens</nombre>
        <nacimiento>&anio;</nacimiento>
    </deportista>
    <deportista id="j2" nacionalidad="Estadounidense">
        <deporte>Natacion</deporte>
        <nombre>Mark Spitz</nombre>
        <nacimiento>&anio;</nacimiento>
    </deportista>
</deportistas>

