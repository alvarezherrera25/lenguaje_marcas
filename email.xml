reglas para definir un email: campos origen, destinatario, asunto.
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE email [
    <!ELEMENT email (origen, destinatario, asunto, mensaje?)>
    <!ELEMENT origen (#PCDATA)>
    <!ELEMENT destinatario (#PCDATA)>
    <!ELEMENT asunto (#PCDATA)>
    <!ELEMENT mensaje (#PCDATA)>
    ]>
<email>
    <origen>yo@gmail.com</origen>
    <destinatario>tú@gmail.com</destinatario>
    <asunto>Hola</asunto>
    <mensaje>Este es un mensaje de prueba</mensaje>
</email>

